# .env 템플릿 — 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요

# DB 접속 — 앱 전용 최소권한 계정 사용 (슈퍼유저 금지, S2 3-6)
# 스키마 변경(마이그레이션)은 별도 관리자 계정으로만 수행
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=busan_app
DB_PASSWORD=비밀번호입력

# CORS 허용 오리진 (운영 프로파일 전용, S2 3-5 / V4)
# 운영 도메인을 콤마로 구분해 명시 (예: https://cityview.example.com)
# local 프로파일은 application-local.yml에서 localhost:5000 고정
CORS_ALLOWED_ORIGINS=https://운영도메인입력

# 관리 계정 — 인증 골격(S3 3-3, B안)용. 평문 금지, BCrypt 해시만 저장
# 해시 생성 예: htpasswd -bnBC 12 "" '원하는비밀번호' | tr -d ':\n' | sed 's/$2y/$2a/'
# 보호(쓰기·관리·앵커) API가 생기기 전까지는 비워둬도 기동 정상(로그인만 불가)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=BCrypt해시입력
